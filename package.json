{
  "name": "portfolio",
  "type": "module",
  "private": true,
  "description": "slicedearth software engineering portfolio",
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write .prettierrc package.json \"src/**/*.{astro,js,ts,json,css}\" \"public/**/*.js\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"*.{mjs,ts,md}\" \".github/**/*.{yml,yaml,md}\"",
    "format:check": "prettier --check .prettierrc package.json \"src/**/*.{astro,js,ts,json,css}\" \"public/**/*.js\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"*.{mjs,ts,md}\" \".github/**/*.{yml,yaml,md}\"",
    "brand:assets": "node scripts/generate-earth-textures.ts && node scripts/generate-brand-assets.ts",
    "budget": "node scripts/check-performance-budget.ts",
    "links:check": "node scripts/check-external-links.ts",
    "security:check": "node scripts/check-csp-build.ts",
    "test:e2e": "npm run build && npm run test:e2e:built",
    "test:e2e:built": "playwright test",
    "test:e2e:install": "playwright install chromium firefox webkit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slicedearth/portfolio.git"
  },
  "bugs": {
    "url": "https://github.com/slicedearth/portfolio/issues"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/three": "^0.185.4",
    "parse5": "^8.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@lucide/astro": "^1.34.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "three": "^0.185.1"
  }
}
