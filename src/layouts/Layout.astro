---
import "../styles/global.css"
import Header from "../components/layout/Header.astro"
import Footer from "../components/layout/Footer.astro"

interface Props {
  title: string
  description?: string
  pathname?: string
  noindex?: boolean
}

const siteName = "slicedearth"
const siteDescription =
  "Aser plans and builds software for security, public data and the web."
const siteUrl = "https://www.slicedearth.dev"

const {
  title,
  description = siteDescription,
  pathname,
  noindex = false,
} = Astro.props
const canonical = `${siteUrl}${pathname ?? Astro.url.pathname}`
const pageTitle =
  title === "Home"
    ? `Aser - Software Engineer | ${siteName}`
    : `${title} | ${siteName}`
const robots = noindex ? "noindex, nofollow" : "index, follow"
const gaId = import.meta.env.PUBLIC_GA_TRACKING_ID
---

<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      href="/fonts/archivo-latin-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/kalam-latin-700.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#070a0e" />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${siteUrl}/og-image.png`} />
    <meta property="og:image:type" content="image/png" />
    <meta
      property="og:image:alt"
      content="slicedearth portfolio for software engineering and project delivery"
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/og-image.png`} />
    <meta
      name="twitter:image:alt"
      content="slicedearth portfolio for software engineering and project delivery"
    />
    {
      gaId && (
        <>
          <meta name="google-analytics-id" content={gaId} />
          <script is:inline defer src="/analytics.js" />
        </>
      )
    }
  </head>
  <body>
    <div class="flex min-h-screen flex-col">
      <a
        href="#main-content"
        class="fixed top-3 left-3 z-[60] -translate-y-20 rounded-md bg-accent px-4 py-2 font-semibold text-bg transition-transform focus:translate-y-0 motion-reduce:transition-none"
      >
        Skip to content
      </a>
      <Header />
      <main
        id="main-content"
        class="flex flex-1 flex-col pt-18 min-[1920px]:pt-20"
      >
        <slot />
      </main>
      <Footer />
      <script is:inline defer src="/mobile-nav.js"></script>
      <script src="../scripts/reveal.ts"></script>
    </div>
  </body>
</html>
