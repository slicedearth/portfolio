---
import mark from "../../assets/brand/slicedearth-mark.svg?raw"

interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<span class:list={["inline-flex min-w-0 items-center gap-3", className]}>
  <span
    class="brand-mark h-10 w-10 shrink-0"
    aria-hidden="true"
    set:html={mark}
  />
  <span class="brand-word" aria-label="slicedearth">
    <span class="brand-word-part brand-word-part-first" aria-hidden="true"
      >sliced</span
    ><span class="brand-word-part brand-word-part-second" aria-hidden="true"
      >earth</span
    >
  </span>
</span>
