---
import mark from "../../assets/brand/slicedearth-mark.svg?raw"

interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<span class:list={["inline-flex min-w-0 items-center gap-3", className]}>
  <span
    class="brand-mark h-10 w-10 shrink-0"
    aria-hidden="true"
    set:html={mark}
  />
  <span
    class="truncate text-lg leading-none font-bold text-white"
    aria-label="slicedearth"
  >
    slicedearth
  </span>
</span>
