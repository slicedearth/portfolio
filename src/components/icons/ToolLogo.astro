interface Props {
  name: ToolName
  class?: string
}

const { name, class: className } = Astro.props
const logo = toolLogos[name]
---

<span class:list={["inline-block", className]}>
  <svg
    aria-hidden="true"
    class="block h-full w-full"
    focusable="false"
    preserveAspectRatio="xMidYMid meet"
    viewBox={logo.viewBox}
  >
    {
      logo.paths.map(path => (
        <path
          d={path.d}
          fill={path.fill}
          opacity={"opacity" in path ? path.opacity : undefined}
        />
      ))
    }
  </svg>
</span>
