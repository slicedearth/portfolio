---
type ToolName =
  "TypeScript" | "Svelte" | "Python" | "Node.js" | "Astro" | "Playwright"

interface Props {
  name: ToolName
  class?: string
}

const { name, class: className } = Astro.props
---

<span class:list={["inline-block", className]}>
  <svg
    aria-hidden="true"
    class="block h-full w-full"
    fill="none"
    focusable="false"
    preserveAspectRatio="xMidYMid meet"
    viewBox="0 0 24 24"
  >
    {
      name === "TypeScript" && (
        <>
          <rect
            x="2"
            y="2"
            width="20"
            height="20"
            rx="2.5"
            fill="currentColor"
          />
          <path
            d="M5.5 9h6M8.5 9v9"
            stroke="var(--color-bg)"
            stroke-linecap="round"
            stroke-width="1.8"
          />
          <path
            d="M18.4 10.4a3.2 3.2 0 0 0-2.2-.8c-1.3 0-2.2.6-2.2 1.6 0 2.5 4.7 1.4 4.7 4.4 0 1.6-1.3 2.7-3.3 2.7-1.2 0-2.3-.4-3.1-1.2"
            stroke="var(--color-bg)"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.8"
          />
        </>
      )
    }
    {
      name === "Svelte" && (
        <>
          <path
            d="M18.2 5.2a4.4 4.4 0 0 0-6-1.5L7 6.8c-2.5 1.5-2 5.3.8 6.1l7.8 2.3c1.3.4 1.6 2.1.4 2.8l-4.9 3a4.4 4.4 0 0 1-6-1.5"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2.7"
          />
          <path
            d="M5.8 18.8a4.4 4.4 0 0 0 6 1.5l5.2-3.1c2.5-1.5 2-5.3-.8-6.1L8.4 8.8C7.1 8.4 6.8 6.7 8 6l4.9-3a4.4 4.4 0 0 1 6 1.5"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2.7"
          />
        </>
      )
    }
    {
      name === "Python" && (
        <>
          <path
            d="M12.1 2H8.7A3.7 3.7 0 0 0 5 5.7V9h7.1a2.4 2.4 0 0 1 2.4 2.4V5.7A3.7 3.7 0 0 0 10.8 2Z"
            fill="currentColor"
          />
          <circle cx="8" cy="5.4" r="1" fill="var(--color-bg)" />
          <path
            d="M11.9 22h3.4a3.7 3.7 0 0 0 3.7-3.7V15h-7.1a2.4 2.4 0 0 1-2.4-2.4v5.7a3.7 3.7 0 0 0 3.7 3.7Z"
            fill="currentColor"
          />
          <circle cx="16" cy="18.6" r="1" fill="var(--color-bg)" />
          <path
            d="M5 8.5H3.7A2.7 2.7 0 0 0 1 11.2v1.6a2.7 2.7 0 0 0 2.7 2.7h5.8M19 15.5h1.3a2.7 2.7 0 0 0 2.7-2.7v-1.6a2.7 2.7 0 0 0-2.7-2.7h-5.8"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-width="1.8"
          />
        </>
      )
    }
    {
      name === "Node.js" && (
        <>
          <path
            d="m12 2.2 8.5 4.9v9.8L12 21.8l-8.5-4.9V7.1Z"
            fill="currentColor"
          />
          <path
            d="M8.2 16V8l7.6 8V8"
            stroke="var(--color-bg)"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.9"
          />
        </>
      )
    }
    {
      name === "Astro" && (
        <>
          <path
            d="m12 2 8.4 19h-4.2l-1.6-4H9.4l-1.6 4H3.6Zm0 6.5-1.6 5h3.2Z"
            fill="currentColor"
            fill-rule="evenodd"
          />
          <path
            d="m19.2 2.4.5 1.5 1.5.5-1.5.5-.5 1.5-.5-1.5-1.5-.5 1.5-.5Z"
            fill="currentColor"
          />
        </>
      )
    }
    {
      name === "Playwright" && (
        <>
          <path
            d="M2.5 5.5 11 3v8.2c0 3.9-2.1 6.8-5 7.8-2.2-2-3.5-4.8-3.5-8.1Z"
            fill="currentColor"
            opacity="0.55"
          />
          <path
            d="m9.5 7.4 12 3.2v4.6c0 3.8-2.4 6.7-6 7.8-3.6-1.1-6-4-6-7.8Z"
            fill="currentColor"
          />
          <circle cx="13.2" cy="13.5" r="0.9" fill="var(--color-bg)" />
          <circle cx="18" cy="14.8" r="0.9" fill="var(--color-bg)" />
          <path
            d="M12.8 17.4c1.1 1.4 3.2 2 5 .8"
            stroke="var(--color-bg)"
            stroke-linecap="round"
            stroke-width="1.3"
          />
          <path
            d="M4.6 9.5c.9-.7 2-.9 3.1-.5M4.7 13.8c.9-.7 2-.8 3-.3"
            stroke="var(--color-bg)"
            stroke-linecap="round"
            stroke-width="1.2"
          />
        </>
      )
    }
  </svg>
</span>
