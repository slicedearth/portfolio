---
import { ArrowDown, ArrowUpRight } from "@lucide/astro"
import GithubLogo from "../icons/GithubLogo.astro"
import SlicedEarth from "./SlicedEarth.astro"
---

<section class="hero-shell relative flex items-center overflow-hidden border-b border-line bg-bg px-5 py-10 sm:px-8 sm:py-16 lg:py-20">
  <SlicedEarth />
  <div
    class="pointer-events-none absolute inset-0 z-[1] bg-[linear-gradient(90deg,rgba(7,10,14,0.98)_0%,rgba(7,10,14,0.88)_34%,rgba(7,10,14,0.42)_62%,rgba(7,10,14,0.08)_100%)] sm:bg-[linear-gradient(90deg,rgba(7,10,14,0.94)_0%,rgba(7,10,14,0.78)_34%,rgba(7,10,14,0.24)_63%,rgba(7,10,14,0.04)_100%)]"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 z-[1] h-40 bg-gradient-to-t from-bg to-transparent"
    aria-hidden="true"
  ></div>
  <div
    class="hero-raster pointer-events-none absolute inset-0 z-[1]"
    aria-hidden="true"
  ></div>

  <div class="site-frame relative z-[2]">
    <div class="max-w-3xl min-[1920px]:max-w-4xl">
      <p class="animate-fade-in-up flex items-center gap-3 font-code text-xs text-accent uppercase sm:text-sm min-[1920px]:text-base">
        <span class="h-px w-8 bg-accent" aria-hidden="true"></span>
        Digital projects &amp; web operations
      </p>
      <h1 class="hero-title animate-fade-in-up mt-5 font-secondary text-[2.75rem] leading-tight font-bold text-white min-[375px]:text-[3.25rem] sm:mt-6 sm:text-6xl lg:text-8xl min-[1920px]:text-[7rem]">
        Hey, I'm Aser.
      </h1>
      <p class="animate-fade-in-up mt-5 max-w-xl text-base leading-relaxed text-gray-200 sm:mt-6 sm:text-lg lg:max-w-2xl lg:text-xl min-[1920px]:text-2xl">
        I bring experience coordinating web and ecommerce projects, with
        practical knowledge of domains, DNS, hosting and analytics.
      </p>
      <div class="animate-fade-in-up mt-9 flex flex-col flex-wrap items-start gap-3 min-[375px]:flex-row min-[375px]:items-center min-[375px]:gap-2 sm:gap-3">
        <a
          class="inline-flex min-h-12 max-w-full items-center justify-center gap-2 rounded-md bg-accent px-5 py-3 font-semibold text-bg transition-[background-color,transform] hover:bg-accent-dark active:translate-y-px min-[375px]:gap-1.5 min-[375px]:px-3 min-[375px]:text-sm sm:gap-2 sm:px-5 sm:text-base min-[1920px]:min-h-14 min-[1920px]:px-6 min-[1920px]:text-lg motion-reduce:transition-none"
          href="#projects"
        >
          <span>Explore projects</span>
          <ArrowDown
            class="min-[375px]:h-4 min-[375px]:w-4 sm:h-[18px] sm:w-[18px]"
            aria-hidden="true"
            size={18}
            stroke-width={1.8}
          />
        </a>
        <a
          class="inline-flex min-h-12 max-w-full items-center justify-center gap-2 rounded-md border border-gray-500/60 bg-bg/80 px-5 py-3 font-semibold text-white transition-[background-color,border-color,transform] hover:border-gray-300 hover:bg-surface active:translate-y-px min-[375px]:gap-1.5 min-[375px]:px-3 min-[375px]:text-sm sm:gap-2 sm:px-5 sm:text-base min-[1920px]:min-h-14 min-[1920px]:px-6 min-[1920px]:text-lg motion-reduce:transition-none"
          href="https://github.com/slicedearth"
          rel="me noopener noreferrer"
          target="_blank"
          aria-label="GitHub profile for slicedearth"
          aria-describedby="external-window-note"
          data-analytics-type="github_profile_link"
          data-analytics-item="hero"
        >
          <GithubLogo class="h-[19px] w-[19px] min-[375px]:h-4 min-[375px]:w-4 sm:h-[19px] sm:w-[19px]" />
          <span>GitHub profile</span>
          <ArrowUpRight
            class="min-[375px]:h-3.5 min-[375px]:w-3.5 sm:h-4 sm:w-4"
            aria-hidden="true"
            size={16}
            stroke-width={1.8}
          />
        </a>
      </div>
    </div>
  </div>
</section>
