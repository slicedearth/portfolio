---
import { Image } from "astro:assets"
import { ArrowUpRight, BookOpen, GitBranch } from "@lucide/astro"

interface Props {
  title: string
  eyebrow: string
  image: ImageMetadata
  imageAlt: string
  description: string
  highlights: string[]
  tags: string[]
  githubURL: string
  deployedURL?: string
  deployedLabel?: string
  caseStudyURL?: string
  caseStudyLabel?: string
  variant?: "featured" | "secondary" | "compact"
  revealDelay?: number
}
const {
  title,
  eyebrow,
  image,
  imageAlt,
  description,
  highlights,
  tags,
  githubURL,
  deployedURL,
  deployedLabel = "Open project",
  caseStudyURL,
  caseStudyLabel = "Read more",
  variant = "compact",
  revealDelay = 0,
} = Astro.props
const isFeature = variant !== "compact"
const primaryLink = deployedURL ?? caseStudyURL ?? githubURL
const primaryType = deployedURL
  ? "project_website_link"
  : caseStudyURL
    ? "project_case_study_link"
    : "project_github_link"
---

<article
  data-project-card
  data-project-variant={variant}
  data-reveal
  data-reveal-delay={revealDelay || undefined}
  class:list={[
    "group min-w-0 overflow-hidden rounded-md border border-line bg-card",
    isFeature ? "lg:col-span-2 lg:grid lg:items-stretch" : "flex flex-col",
    variant === "featured" && "lg:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)]",
    variant === "secondary" && "lg:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)]",
  ]}
>
  <a
    href={primaryLink}
    rel="noopener noreferrer"
    target="_blank"
    aria-label={`Open ${title}`}
    aria-describedby="external-window-note"
    data-analytics-type={primaryType}
    data-analytics-item={title}
    class:list={[
      "block min-w-0 overflow-hidden bg-bg focus-visible:outline-offset-[-4px]",
      isFeature ? "aspect-video lg:aspect-auto" : "shrink-0",
      variant === "secondary" && "lg:order-2",
    ]}
  >
    <figure class:list={["relative min-h-0", isFeature && "h-full"]}>
      <Image
        src={image}
        alt={imageAlt}
        width={isFeature ? 1600 : 960}
        layout="constrained"
        quality={84}
        loading="lazy"
        data-project-image
        class:list={["w-full object-contain", isFeature ? "h-full" : "h-auto"]}
      />
    </figure>
  </a>
  <div
    class:list={[
      "flex min-w-0 flex-1 flex-col p-5 sm:p-6",
      isFeature && "lg:justify-center lg:p-8",
      variant === "featured" && "min-[1920px]:p-10",
    ]}
  >
    <p class="font-code text-xs leading-relaxed text-accent sm:text-sm">
      {eyebrow}
    </p>
    <h3
      class:list={[
        "mt-2 font-semibold text-white",
        isFeature
          ? "text-2xl sm:text-3xl min-[1920px]:text-4xl"
          : "text-xl sm:text-2xl",
      ]}
    >
      {title}
    </h3>
    <p
      class:list={[
        "mt-3 leading-relaxed text-gray-200",
        isFeature ? "text-base min-[1920px]:text-lg" : "text-sm sm:text-base",
      ]}
    >
      {description}
    </p>
    <ul class="mt-4 space-y-2 text-sm leading-relaxed text-muted">
      {highlights.map(highlight => (
        <li class="border-l border-accent/40 pl-3">{highlight}</li>
      ))}
    </ul>
    <ul
      class="mt-4 flex flex-wrap gap-x-4 gap-y-1 font-code text-xs text-muted"
      aria-label={`${title} technologies and focus areas`}
    >
      {tags.map(tag => (
        <li>{tag}</li>
      ))}
    </ul>
    <div class:list={["pt-5", !isFeature && "mt-auto"]}>
      {deployedURL && (
        <a
          href={deployedURL}
          rel="noopener noreferrer"
          target="_blank"
          aria-label={`${deployedLabel}: ${title}`}
          aria-describedby="external-window-note"
          data-analytics-type="project_website_link"
          data-analytics-item={title}
          class="inline-flex min-h-11 max-w-full items-center justify-center gap-2 rounded-md bg-accent px-4 py-2 text-sm font-semibold text-bg transition-colors hover:bg-accent-dark motion-reduce:transition-none"
        >
          <>
            <span>{deployedLabel}</span>
            <ArrowUpRight size={16} aria-hidden="true" />
          </>
        </a>
      )}
      <div class="mt-2 flex flex-wrap gap-x-5 text-sm text-gray-300">
        <a
          href={githubURL}
          rel="noopener noreferrer"
          target="_blank"
          aria-label={`Source code for ${title}`}
          aria-describedby="external-window-note"
          data-analytics-type="project_github_link"
          data-analytics-item={title}
          class="inline-flex min-h-11 items-center gap-2 underline-offset-4 hover:text-accent hover:underline"
        >
          <GitBranch size={15} aria-hidden="true" />
          <span>Source code</span>
        </a>
        {caseStudyURL && (
          <a
            href={caseStudyURL}
            rel="noopener noreferrer"
            target="_blank"
            aria-label={`${caseStudyLabel}: ${title}`}
            aria-describedby="external-window-note"
            data-analytics-type="project_case_study_link"
            data-analytics-item={title}
            class="inline-flex min-h-11 items-center gap-2 underline-offset-4 hover:text-accent hover:underline"
          >
            <>
              <BookOpen size={15} aria-hidden="true" />
              <span>{caseStudyLabel}</span>
            </>
          </a>
        )}
      </div>
    </div>
  </div>
</article>
