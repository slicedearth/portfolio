---
import { Image } from "astro:assets"
import { ArrowUpRight, BookOpen, GitBranch } from "@lucide/astro"

interface Props {
  title: string
  eyebrow: string
  image: ImageMetadata
  imageAlt: string
  description: string
  highlights: string[]
  tags: string[]
  githubURL: string
  deployedURL?: string
  deployedLabel?: string
  caseStudyURL?: string
  caseStudyLabel?: string
  variant?: "featured" | "standard"
  revealDelay?: number
}

const {
  title,
  eyebrow,
  image,
  imageAlt,
  description,
  highlights,
  tags,
  githubURL,
  deployedURL,
  deployedLabel = "Open project",
  caseStudyURL,
  caseStudyLabel = "Read more",
  variant = "standard",
  revealDelay = 0,
} = Astro.props

const isFeatured = variant === "featured"
const primaryLink = deployedURL
  ? {
      href: deployedURL,
      analyticsType: "project_website_link",
    }
  : caseStudyURL
    ? {
        href: caseStudyURL,
        analyticsType: "project_case_study_link",
      }
    : {
        href: githubURL,
        analyticsType: "project_github_link",
      }
const actionCount =
  1 + Number(Boolean(deployedURL)) + Number(Boolean(caseStudyURL))
---

<article
  data-project-card
  data-reveal
  data-reveal-delay={revealDelay || undefined}
  class:list={[
    "group overflow-hidden rounded-md border border-line bg-card transition-[border-color,box-shadow] duration-500 ease-out hover:border-accent/50 hover:shadow-xl hover:shadow-bg/40 motion-reduce:transition-none",
    isFeatured
      ? "lg:grid lg:grid-cols-[minmax(0,1.45fr)_minmax(21rem,0.85fr)]"
      : "flex h-full flex-col",
  ]}
>
  <a
    href={primaryLink.href}
    rel="noopener noreferrer"
    target="_blank"
    aria-label={`Open ${title}`}
    data-analytics-type={primaryLink.analyticsType}
    data-analytics-item={title}
    class:list={[
      "block overflow-hidden border-line bg-bg focus-visible:outline-offset-[-2px]",
      isFeatured
        ? "aspect-video border-b lg:aspect-auto lg:min-h-[31rem] lg:border-r lg:border-b-0"
        : "aspect-video border-b",
    ]}
  >
    <figure class="relative h-full overflow-hidden">
      <Image
        src={image}
        alt={imageAlt}
        width={isFeatured ? 1200 : 680}
        layout="constrained"
        quality={isFeatured ? 92 : 84}
        loading="lazy"
        class="h-full w-full object-cover transition-transform duration-700 ease-out motion-safe:group-hover:scale-[1.015] motion-reduce:transition-none"
      />
    </figure>
  </a>

  <div class:list={["flex flex-1 flex-col", isFeatured ? "p-6 sm:p-8" : "p-5"]}>
    <p class="mb-3 font-code text-sm text-accent">{eyebrow}</p>
    <h3
      class:list={[
        "font-semibold text-white",
        isFeatured ? "text-3xl" : "text-2xl",
      ]}
    >
      {title}
    </h3>
    <p class="mt-3 leading-relaxed text-muted">{description}</p>

    <div class="mt-6 flex-1 border-t border-line pt-5">
      <p class="font-code text-sm text-gray-300">Key decisions</p>
      <ul class="mt-3 space-y-3">
        {
          highlights.map(highlight => (
            <li class="border-l border-accent/60 pl-3 text-sm leading-relaxed text-gray-300">
              {highlight}
            </li>
          ))
        }
      </ul>
    </div>

    <ul
      class="mt-5 flex flex-wrap gap-2"
      aria-label={`${title} technologies and focus areas`}
    >
      {
        tags.map(tag => (
          <li class="border border-line bg-bg/50 px-2.5 py-1 font-code text-xs text-gray-300">
            {tag}
          </li>
        ))
      }
    </ul>

    <div
      class:list={[
        "mt-6 grid grid-cols-1 gap-2 min-[420px]:grid-cols-2",
        !isFeatured && actionCount === 3 && "xl:grid-cols-3",
      ]}
    >
      {
        deployedURL && (
          <a
            class="inline-flex min-h-11 w-full min-w-0 items-center justify-center gap-2 whitespace-nowrap rounded-md bg-accent px-4 py-2 text-sm font-semibold text-bg transition-[background-color,transform] hover:bg-accent-dark active:translate-y-px motion-reduce:transition-none"
            href={deployedURL}
            rel="noopener noreferrer"
            target="_blank"
            data-analytics-type="project_website_link"
            data-analytics-item={title}
          >
            <span>{deployedLabel}</span>
            <ArrowUpRight
              class="transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 motion-reduce:transition-none"
              aria-hidden="true"
              size={16}
              stroke-width={1.8}
            />
          </a>
        )
      }
      {
        caseStudyURL && (
          <a
            class="inline-flex min-h-11 w-full min-w-0 items-center justify-center gap-2 whitespace-nowrap rounded-md border border-line bg-surface px-4 py-2 text-sm font-semibold text-white transition-[background-color,border-color,transform] hover:border-gray-400 hover:bg-surface-hover active:translate-y-px motion-reduce:transition-none"
            href={caseStudyURL}
            rel="noopener noreferrer"
            target="_blank"
            data-analytics-type="project_case_study_link"
            data-analytics-item={title}
          >
            <BookOpen aria-hidden="true" size={16} stroke-width={1.8} />
            <span>{caseStudyLabel}</span>
          </a>
        )
      }
      <a
        class:list={[
          "inline-flex min-h-11 w-full min-w-0 items-center justify-center gap-2 whitespace-nowrap rounded-md border border-line bg-surface px-4 py-2 text-sm font-semibold text-white transition-[background-color,border-color,transform] hover:border-gray-400 hover:bg-surface-hover active:translate-y-px motion-reduce:transition-none",
          actionCount === 3 &&
            (isFeatured
              ? "min-[420px]:col-span-2"
              : "min-[420px]:col-span-2 xl:col-span-1"),
        ]}
        href={githubURL}
        rel="noopener noreferrer"
        target="_blank"
        data-analytics-type="project_github_link"
        data-analytics-item={title}
      >
        <GitBranch aria-hidden="true" size={16} stroke-width={1.8} />
        <span>Source code</span>
      </a>
    </div>
  </div>
</article>
