---
import { getCollection } from "astro:content"
import ProjectItem from "./ProjectItem.astro"

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
)
const images = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/images/projects/*.webp",
  { eager: true },
)

const [featuredProject, ...remainingProjects] = projects

const imageFor = (filename: string) => {
  const path = `../../assets/images/projects/${filename}`
  const image = images[path]

  if (!image) {
    throw new Error(`Missing project image: ${path}`)
  }

  return image.default
}
---

<section
  id="projects"
  class="border-b border-line bg-surface/35 px-5 py-24 sm:px-8 lg:py-32"
>
  <div class="mx-auto max-w-7xl">
    <header data-reveal class="mb-12 max-w-3xl">
      <h2 class="text-4xl font-bold text-white sm:text-5xl">Projects.</h2>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">
        {projects.length} projects across domain research, public records, browser
        support and interactive products.
      </p>
    </header>

    <div class="space-y-6">
      {
        featuredProject && (
          <ProjectItem
            title={featuredProject.data.title}
            eyebrow={featuredProject.data.eyebrow}
            image={imageFor(featuredProject.data.image)}
            imageAlt={featuredProject.data.image_alt}
            description={featuredProject.data.description}
            highlights={featuredProject.data.highlights}
            tags={featuredProject.data.tags}
            githubURL={featuredProject.data.githubURL}
            deployedURL={featuredProject.data.deployedURL}
            deployedLabel={featuredProject.data.deployedLabel}
            caseStudyURL={featuredProject.data.caseStudyURL}
            caseStudyLabel={featuredProject.data.caseStudyLabel}
            variant="featured"
            revealDelay={90}
          />
        )
      }

      <div class="grid gap-6 lg:grid-cols-2">
        {
          remainingProjects.map((project, index) => (
            <ProjectItem
              title={project.data.title}
              eyebrow={project.data.eyebrow}
              image={imageFor(project.data.image)}
              imageAlt={project.data.image_alt}
              description={project.data.description}
              highlights={project.data.highlights}
              tags={project.data.tags}
              githubURL={project.data.githubURL}
              deployedURL={project.data.deployedURL}
              deployedLabel={project.data.deployedLabel}
              caseStudyURL={project.data.caseStudyURL}
              caseStudyLabel={project.data.caseStudyLabel}
              revealDelay={(index % 2) * 70}
            />
          ))
        }
      </div>
    </div>
  </div>
</section>
