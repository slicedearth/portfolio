---
import { getCollection } from "astro:content"
import ProjectItem from "./ProjectItem.astro"

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
)
const images = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/images/projects/*.webp",
  { eager: true },
)
const imageFor = (filename: string) => {
  const path = `../../assets/images/projects/${filename}`
  if (!images[path]) throw new Error(`Missing project image: ${path}`)
  return images[path].default
}
---

<section
  id="projects"
  class="section-planes border-b border-line bg-surface/35 px-5 py-14 sm:px-8 sm:py-16"
>
  <div class="site-frame">
    <header
      data-reveal
      class="mb-8 flex flex-wrap items-end justify-between gap-4 sm:mb-10"
    >
      <div>
        <h2 class="text-3xl font-bold text-white sm:text-4xl min-[1920px]:text-5xl">
          Projects
        </h2>
        <p class="mt-3 max-w-2xl leading-relaxed text-muted sm:text-lg">
          Tools for investigating domains, understanding public records and
          making everyday tasks easier.
        </p>
      </div>
    </header>
    <div class="grid gap-5 lg:grid-cols-2 sm:gap-6">
      {projects.map(project => (
        <ProjectItem
          title={project.data.title}
          eyebrow={project.data.eyebrow}
          image={imageFor(project.data.image)}
          imageAlt={project.data.image_alt}
          description={project.data.description}
          highlights={project.data.highlights}
          tags={project.data.tags}
          githubURL={project.data.githubURL}
          deployedURL={project.data.deployedURL}
          deployedLabel={project.data.deployedLabel}
          caseStudyURL={project.data.caseStudyURL}
          caseStudyLabel={project.data.caseStudyLabel}
          variant={project.data.presentation}
        />
      ))}
    </div>
  </div>
</section>
