---
import { Image } from "astro:assets"
import heroPoster from "../../assets/brand/hero-slicedearth.webp"
---

<div
  class="sliced-earth pointer-events-none absolute inset-0 z-0 overflow-hidden"
  data-sliced-earth
  aria-hidden="true"
>
  <Image
    src={heroPoster}
    alt=""
    layout="full-width"
    loading="eager"
    fetchpriority="high"
    quality={84}
    sizes="(max-width: 639px) 155vw, 100vw"
    class="sliced-earth__poster absolute inset-0 h-full w-full scale-[1.55] object-contain object-[68%_center] sm:scale-100 sm:object-contain sm:object-center"
    data-hero-image
  />
  <canvas
    class="sliced-earth__canvas absolute inset-0 h-full w-full"
    data-earth-canvas
  ></canvas>
</div>
<button
  type="button"
  hidden
  data-earth-toggle
  aria-pressed="false"
  class="absolute right-5 bottom-5 z-[3] min-h-11 rounded-md border border-line bg-bg/90 px-3 font-code text-xs text-muted hover:text-white focus-visible:outline-2 focus-visible:outline-accent"
>
  Static view
</button>

<script>
  import { mountEarthLifecycle } from "../../scripts/earth-lifecycle"
  let dispose: (() => void) | undefined
  const mount = () => {
    dispose?.()
    const root = document.querySelector<HTMLElement>("[data-sliced-earth]")
    const button = document.querySelector<HTMLButtonElement>(
      "[data-earth-toggle]",
    )
    if (root && button) dispose = mountEarthLifecycle(root, button)
  }
  mount()
  document.addEventListener("astro:page-load", mount)
  document.addEventListener("astro:before-swap", () => {
    dispose?.()
    dispose = undefined
  })
</script>

<style>
  .sliced-earth {
    background: #070a0e;
  }
  .sliced-earth__canvas {
    opacity: 0;
  }
  .sliced-earth[data-earth-handoff="complete"] .sliced-earth__canvas {
    opacity: 1;
  }
  .sliced-earth[data-earth-handoff="complete"] .sliced-earth__poster {
    opacity: 0;
  }
</style>
