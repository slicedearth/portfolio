---
import { getCollection } from "astro:content"
import ToolLogo from "../icons/ToolLogo.astro"

const skills = (await getCollection("skills")).sort(
  (a, b) => a.data.order - b.data.order,
)

const principles = [
  {
    title: "Define",
    description:
      "Establish the requirements, boundaries and exclusions before implementation begins.",
  },
  {
    title: "Implement",
    description:
      "Deliver the agreed scope with maintainable code and accessible interfaces.",
  },
  {
    title: "Validate",
    description:
      "Test critical paths and edge cases, then resolve findings before release.",
  },
]
---

<section
  id="about"
  class="border-b border-line bg-bg px-5 py-24 sm:px-8 lg:py-32"
>
  <div class="mx-auto max-w-7xl">
    <header data-reveal class="max-w-3xl">
      <h2 class="text-4xl font-bold text-white sm:text-5xl">About.</h2>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">
        Based in Melbourne, Australia, I work across software engineering and
        project delivery, from initial requirements through implementation,
        release and maintenance.
      </p>
    </header>

    <div
      data-reveal
      data-reveal-delay="90"
      class="mt-14 grid gap-14 border-t border-line pt-10 lg:grid-cols-[minmax(0,1.05fr)_minmax(22rem,0.95fr)] lg:gap-20"
    >
      <div>
        <h3 class="text-2xl font-semibold text-white">
          Engineering and delivery
        </h3>
        <p class="mt-4 max-w-2xl text-lg leading-relaxed text-gray-200">
          I combine product scoping and delivery planning with hands-on
          implementation. I keep boundaries explicit, make limitations visible
          and verify releases through automated and manual testing.
        </p>
        <ol class="mt-8 border-t border-line">
          {
            principles.map(principle => (
              <li class="grid gap-2 border-b border-line py-5 sm:grid-cols-[7rem_1fr] sm:gap-5">
                <span class="font-code text-sm text-accent">
                  {principle.title}
                </span>
                <span class="leading-relaxed text-muted">
                  {principle.description}
                </span>
              </li>
            ))
          }
        </ol>
      </div>
      <div>
        <h3 class="text-2xl font-semibold text-white">Core tools</h3>
        <p class="mt-4 max-w-lg leading-relaxed text-muted">
          The technologies I use most often for application development, testing
          and delivery.
        </p>
        <ol class="mt-8 grid grid-cols-2 gap-x-6 gap-y-7">
          {
            skills.map(skill => {
              return (
                <li class="group flex items-center gap-3">
                  <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-md border border-line bg-surface text-accent transition-colors group-hover:border-accent/60 motion-reduce:transition-none">
                    <ToolLogo name={skill.data.title} class="h-7 w-7" />
                  </span>
                  <span class="font-semibold text-gray-100">
                    {skill.data.title}
                  </span>
                </li>
              )
            })
          }
        </ol>
      </div>
    </div>
  </div>
</section>
