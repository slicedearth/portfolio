---
import { getCollection } from "astro:content"
import ToolLogo from "../icons/ToolLogo.astro"

const technologies = (await getCollection("skills")).sort(
  (a, b) => a.data.order - b.data.order,
)
---

<section
  id="about"
  class="border-t border-line bg-bg px-5 py-14 sm:px-8 sm:py-16"
>
  <div class="site-frame">
    <header
      data-reveal
      class="mb-8 flex flex-wrap items-baseline justify-between gap-4"
    >
      <h2 class="text-3xl font-bold text-white sm:text-4xl min-[1920px]:text-5xl">
        About
      </h2>
      <p class="font-code text-xs text-muted sm:text-sm">
        Melbourne, Australia
      </p>
    </header>
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-16" data-reveal>
      <div class="max-w-2xl">
        <h3 class="text-xl font-semibold text-white sm:text-2xl">
          How I approach projects
        </h3>
        <p class="mt-4 leading-relaxed text-muted sm:text-lg">
          I focus on clear requirements, useful documentation and keeping
          developers, designers and stakeholders aligned as a project
          progresses.
        </p>
      </div>
      <div>
        <h3 class="text-xl font-semibold text-white sm:text-2xl">
          Technologies used in these projects
        </h3>
        <p class="mt-4 max-w-xl leading-relaxed text-muted">
          The applications use a mix of web frameworks, data-processing tools
          and browser testing libraries.
        </p>
        <ul
          class="mt-5 grid grid-cols-2 gap-x-5 gap-y-1 sm:grid-cols-3"
          aria-label="Project technologies"
        >
          {technologies.map(technology => (
            <li class="flex min-w-0 items-center gap-3 py-3">
              <>
                <ToolLogo
                  name={technology.data.title}
                  class="h-6 w-6 shrink-0 text-accent"
                />
                <span class="text-sm font-medium text-gray-200 sm:text-base">
                  {technology.data.title}
                </span>
              </>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
