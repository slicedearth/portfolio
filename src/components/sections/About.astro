---
import { getCollection } from "astro:content"
import ToolLogo from "../icons/ToolLogo.astro"

const skills = (await getCollection("skills")).sort(
  (a, b) => a.data.order - b.data.order,
)

const principles = [
  {
    title: "Define",
    description:
      "Establish the requirements, boundaries and exclusions before implementation begins.",
  },
  {
    title: "Implement",
    description:
      "Deliver the agreed scope with maintainable code and accessible interfaces.",
  },
  {
    title: "Validate",
    description:
      "Test critical paths and edge cases, then resolve findings before release.",
  },
]
---

<section
  id="about"
  class="section-planes section-planes-offset border-b border-line bg-bg px-5 py-20 sm:px-8 lg:py-24"
>
  <div class="mx-auto max-w-7xl">
    <header data-reveal class="border-b border-line pb-8 sm:pb-10">
      <div
        class="grid gap-7 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end lg:gap-12"
      >
        <div class="border-l-2 border-accent/80 pl-5 sm:pl-6">
          <h2 class="text-4xl font-bold text-white sm:text-5xl">About</h2>
          <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">
            I bring experience coordinating developers, designers and
            stakeholders across concurrent web and ecommerce projects. My work
            also spans domains, DNS, hosting and analytics.
          </p>
        </div>

        <div
          class="flex items-center gap-4 border-y border-line py-4 lg:min-w-[21rem]"
        >
          <span
            class="h-2 w-2 shrink-0 rounded-full bg-accent"
            aria-hidden="true"></span>
          <div>
            <p class="font-code text-xs text-accent">Based in</p>
            <p class="mt-1 font-semibold text-gray-100">Melbourne, Australia</p>
          </div>
        </div>
      </div>
    </header>

    <ol
      data-reveal
      data-reveal-delay="90"
      class="mt-10 grid border border-line bg-surface/20 sm:grid-cols-3 sm:divide-x sm:divide-line"
    >
      {
        principles.map(principle => (
          <li class="border-b border-line p-5 last:border-b-0 sm:border-b-0 sm:p-6">
            <h3 class="text-lg font-semibold text-white">{principle.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted">
              {principle.description}
            </p>
          </li>
        ))
      }
    </ol>

    <div
      data-reveal
      data-reveal-delay="140"
      class="mt-14 grid gap-14 lg:grid-cols-[minmax(0,0.9fr)_minmax(26rem,1.1fr)] lg:gap-20"
    >
      <div>
        <div class="flex items-center gap-5">
          <h3 class="shrink-0 text-2xl font-semibold text-white">
            Engineering judgement
          </h3>
          <span class="h-px flex-1 bg-line" aria-hidden="true"></span>
        </div>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-gray-200">
          I favour bounded systems, clear source context and interfaces that
          show uncertainty instead of hiding it. The aim is software that people
          can understand, operate and trust.
        </p>
      </div>

      <div>
        <div class="flex items-center gap-5">
          <h3 class="shrink-0 text-2xl font-semibold text-white">Core tools</h3>
          <span class="h-px flex-1 bg-line" aria-hidden="true"></span>
        </div>
        <p class="mt-5 max-w-lg leading-relaxed text-muted">
          A focused toolkit for typed applications, data processing, static
          publishing and browser-level testing.
        </p>
        <ol
          class="mt-5 grid grid-cols-2 gap-x-6 sm:grid-cols-3 lg:grid-cols-2 xl:grid-cols-3"
        >
          {
            skills.map(skill => {
              return (
                <li class="group flex items-center gap-3 border-b border-line py-4">
                  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md border border-line bg-surface text-accent transition-colors group-hover:border-accent/60 motion-reduce:transition-none">
                    <ToolLogo name={skill.data.title} class="h-7 w-7" />
                  </span>
                  <span class="font-semibold text-gray-100">
                    {skill.data.title}
                  </span>
                </li>
              )
            })
          }
        </ol>
      </div>
    </div>
  </div>
</section>
