---
import { getCollection } from "astro:content"
import ToolLogo from "../icons/ToolLogo.astro"

const technologies = (await getCollection("skills")).sort(
  (a, b) => a.data.order - b.data.order,
)
---

<section
  id="about"
  class="section-planes section-planes-offset border-t border-line bg-bg px-5 py-14 sm:px-8 sm:py-16"
>
  <div class="site-frame">
    <header
      data-reveal
      class="mb-8 flex flex-wrap items-baseline justify-between gap-4"
    >
      <h2 class="text-3xl font-bold text-white sm:text-4xl min-[1920px]:text-5xl">
        About
      </h2>
      <p class="font-code text-xs text-muted sm:text-sm">
        Melbourne, Australia
      </p>
    </header>
    <div
      class="grid gap-10 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:gap-16"
      data-reveal
    >
      <div class="max-w-2xl">
        <h3 class="text-xl font-semibold text-white sm:text-2xl">
          How I approach projects
        </h3>
        <p class="mt-4 max-w-xl text-lg leading-relaxed text-gray-200 sm:text-xl lg:text-2xl">
          I focus on clear requirements, useful documentation and keeping
          developers, designers and stakeholders aligned as a project
          progresses.
        </p>
      </div>
      <div>
        <h3 class="text-xl font-semibold text-white sm:text-2xl">
          Tools &amp; technologies
        </h3>
        <ul
          class="technology-list mt-5 grid gap-x-5 gap-y-1"
          aria-label="Tools and technologies"
        >
          {technologies.map(technology => (
            <li class="flex min-w-0 items-center gap-3 py-3">
              <>
                <ToolLogo
                  name={technology.data.title}
                  class="h-6 w-6 shrink-0 text-accent"
                />
                <span class="text-sm font-medium text-gray-200 sm:text-base">
                  {technology.data.title}
                </span>
              </>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .technology-list {
    /* Let enlarged labels reflow without overflowing narrow columns. */
    grid-template-columns: repeat(
      auto-fit,
      minmax(min(100%, max(8rem, 30%)), 1fr)
    );
  }
</style>
