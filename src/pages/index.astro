---
import { getCollection } from "astro:content"
import Layout from "../layouts/Layout.astro"
import Hero from "../components/sections/Hero.astro"
import Projects from "../components/sections/Projects.astro"
import About from "../components/sections/About.astro"
import { serialiseJsonLd } from "../utils/json-ld"

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
)

const siteUrl = "https://www.slicedearth.dev/"
const personId = `${siteUrl}#aser`
const projectListId = `${siteUrl}#projects`
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfilePage",
      "@id": `${siteUrl}#profile`,
      url: siteUrl,
      name: "Aser | Digital Projects & Web Operations",
      mainEntity: { "@id": personId },
      hasPart: { "@id": projectListId },
    },
    {
      "@type": "Person",
      "@id": personId,
      name: "Aser",
      alternateName: "slicedearth",
      url: siteUrl,
      sameAs: ["https://github.com/slicedearth"],
    },
    {
      "@type": "ItemList",
      "@id": projectListId,
      name: "Projects",
      numberOfItems: projects.length,
      itemListElement: projects.map((project, index) => ({
        "@type": "ListItem",
        position: index + 1,
        item: {
          "@type": "SoftwareApplication",
          name: project.data.title,
          description: project.data.description,
          url: project.data.deployedURL ?? project.data.githubURL,
          codeRepository: project.data.githubURL,
        },
      })),
    },
  ],
}
---

<Layout
  title="Home"
  description="Aser's portfolio of digital projects and web operations, with experience in web and ecommerce coordination, domains, DNS, hosting and analytics."
  pathname={Astro.url.pathname}
>
  <script
    is:inline
    type="application/ld+json"
    set:html={serialiseJsonLd(structuredData)}
  />
  <Hero />
  <Projects />
  <About />
</Layout>
